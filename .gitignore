# Operating system
.DS_Store

# Quarto
.quarto/
**/*.quarto_ipynb

# Demo fixture extensions: installed by scripts/prepare-fixtures.sh at pinned
# versions rather than vendored. They were two byte-identical 1.3 MB trees.
/demo-folium-page/_extensions/
/demo-folium-site/_extensions/

# Rendered demo output
/demo/

# Local environments
.env
.env.*
.venv/
renv/library/
renv/staging/

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.bak

# Local agent instructions (not part of the distributable skill)
AGENTS.md

# Local audits and development notes. Excluding the directory's contents rather
# than the directory itself is deliberate: git will not descend into an excluded
# directory, so a negation below could never re-include anything.
/docs/*
!/docs/CONTEXT.md

# Skill-creator eval runs (large, regenerable)
/evals-workspace/
